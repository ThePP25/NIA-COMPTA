{
  "name": "nia-compta",
  "productName": "NIA Compta",
  "version": "1.1.0",
  "description": "Logiciel de comptabilité SYSCOHADA pour la RDC",
  "main": "main.js",
  "author": "NIA Holding SARL",
  "license": "UNLICENSED",
  "scripts": {
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.niaholding.compta",
    "productName": "NIA Compta",
    "artifactName": "NIA-Compta-Setup-${version}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "icon.png",
      "icon.ico",
      "package.json"
    ],
    "directories": {
      "buildResources": "."
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NIA Compta",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "deleteAppDataOnUninstall": false,
      "language": "1036"
    },
    "publish": [
      {
        "provider": "github"
      }
    ]
  }
}